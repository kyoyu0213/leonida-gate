{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "redirects": [
    { "source": "/news/17", "destination": "/news/19", "statusCode": 301 },
    { "source": "/en/news/17", "destination": "/en/news/19", "statusCode": 301 },
    {
      "source": "/news/:id(3|4|5|6|7|8|9|11|12|13|14|15|20|21|22|23|24|25)",
      "destination": "/fivem-gtarp",
      "statusCode": 302
    },
    {
      "source": "/en/news/:id(3|4|5|6|7|8|9|11|12|13|14|15|20|21|22|23|24|25)",
      "destination": "/en/fivem-gtarp",
      "statusCode": 302
    }
  ],
  "rewrites": [
    { "source": "/sitemap-news.xml", "destination": "/api/sitemap-news" },
    { "source": "/news/:id(\\d+)", "destination": "/api/news-og?id=:id" },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
